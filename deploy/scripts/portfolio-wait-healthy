#!/bin/sh
set -u

unset XDG_RUNTIME_DIR

attempt=1
max_attempts=30

while [ "$attempt" -le "$max_attempts" ]; do
    all_healthy=1
    summary=""

    for container in portfolio_db portfolio_web portfolio_nginx; do
        health="$(
            /usr/bin/podman inspect "$container" \
              --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
              2>/dev/null
        )" || health="missing"

        summary="${summary}${container}=${health} "

        if [ "$health" != "healthy" ]; then
            all_healthy=0
        fi
    done

    printf 'Health attempt %s/%s: %s\n' \
      "$attempt" "$max_attempts" "$summary"

    if [ "$all_healthy" -eq 1 ]; then
        exit 0
    fi

    attempt=$((attempt + 1))
    sleep 5
done

echo "Portfolio containers did not become healthy in time." >&2
exit 1
